---
import Layout from '@/layouts/Layout.astro';
import Navbar from '@/components/common/Navbar';
import Hero from '@/components/home/hero/Hero';
import About from '@/components/home/about/About.astro';
import Projects from '@/components/home/projects/Projects';
import Experience from '@/components/home/experience/Experience.astro';
import Contact from '@/components/home/contact/Contact';
import Footer from '@/components/home/Footer.astro';

import { basics } from '@cv';

const { name } = basics;
---

<Layout title={`${name} - Portfolio`}>
  <Navbar client:load />
  <Hero client:load />
  <div class="container mx-auto max-w-7xl">
    <About />
    <Projects client:load />
    <Experience />
    {/* testimonials */}
    <Contact client:load />
    <Footer />
  </div>
</Layout>
