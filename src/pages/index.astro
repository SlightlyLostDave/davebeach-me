---
import Layout from '@/layouts/Layout.astro';
import Navbar from '@/components/Navbar.jsx';
import Hero from '@/components/home/hero/Hero.jsx';
import About from '@/components/home/about/About.astro';
import Experience from '@/components/home/experience/Experience.astro';

import { basics } from '@cv';

const { name } = basics;
---

<Layout title={`${name} - Portfolio`}>
  <div class="container mx-auto max-w-7xl">
    <Navbar client:load />
    <Hero client:load />
    <About />
    {/* projects */}
    <Experience />
    {/* testimonials */}
    {/* contact */}
    {/* footer */}
  </div>
</Layout>
