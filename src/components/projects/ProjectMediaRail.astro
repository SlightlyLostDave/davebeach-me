---
const { media, title } = Astro.props;
---

<div class="flex flex-col gap-6 lg:gap-8 c-space py-4 lg:py-6">
  {
    media.map((item, index) =>
      item.type === 'video' ? (
        <video
          class="w-full"
          src={item.src}
          poster={item.poster}
          autoplay
          muted
          loop
          playsinline
          preload={index === 0 ? 'metadata' : 'none'}
        />
      ) : (
        <img
          class="w-full"
          src={item.src}
          alt={`${title} - image ${index + 1}`}
          loading={index === 0 ? 'eager' : 'lazy'}
        />
      ),
    )
  }
</div>
