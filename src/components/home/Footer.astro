---
import { Icon } from 'astro-icon/components';

import { social } from '@cv';

const year = new Date().getFullYear();
---

<section
  class="flex flex-wrap items-center justify-between gap-5 pb-3 text-sm text-neutral-400 c-space"
>
  <div
    class="mb-4 bg-gradient-to-r from-transparent via-neutral-700 to-transparent h-[1px] w-full"
  >
  </div>
  <!-- <div class="flex gap-2">
    <p>Terms & Conditions</p>
    <p>|</p>
    <p>Privacy Policy</p>
  </div> -->
  <div class="flex gap-3">
    {
      social.map((social, index) => (
        <a href={social.url}>
          <Icon name={social.icon} width="1.25rem" />
        </a>
      ))
    }
  </div>
  <p>©{year} Dave Beach. All rights reserved.</p>
</section>
